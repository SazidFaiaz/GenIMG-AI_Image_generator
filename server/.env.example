PORT=8080
MONGODB_URL=mongodb://127.0.0.1:27017/genimg

# Hugging Face (required for image generation)
# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
HF_MODEL=black-forest-labs/FLUX.1-dev
HF_PROVIDER=fal-ai
HF_INFERENCE_STEPS=5

# Optional: Cloudinary (recommended for permanent image hosting)
# https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
