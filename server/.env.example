PORT=8080

# MongoDB Atlas (replace with your credentials)
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@cluster0.1o2yw3f.mongodb.net/genimg?retryWrites=true&w=majority&appName=Cluster0

# Hugging Face (required for image generation)
# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
HF_MODEL=black-forest-labs/FLUX.1-dev
HF_PROVIDER=fal-ai
HF_INFERENCE_STEPS=5

# Optional: Cloudinary (recommended for permanent image hosting)
# https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
